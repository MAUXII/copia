{
  "slug": "card-stack-scroll",
  "name": "Card Stack Scroll",
  "description": "Cards pin to the top and pile into a stack as the page scrolls, each buried card shrinking and dimming; uses the existing scroller, never its own box.",
  "category": "cards",
  "tags": [
    "scroll",
    "sticky",
    "stack",
    "cards"
  ],
  "author": {
    "name": "Copia",
    "github": "MAUXII"
  },
  "inspiration": {
    "author": "Skiper UI",
    "url": "https://skiper-ui.com/v1/skiper16",
    "handle": "skiper-ui"
  },
  "dependencies": [
    "motion"
  ],
  "props": [
    {
      "name": "items",
      "type": "ReactNode[]",
      "default": "-",
      "description": "Card contents."
    },
    {
      "name": "cardHeight",
      "type": "number | string",
      "default": "\"min(60vh, 420px)\"",
      "description": "Card height: pixels or any CSS length."
    },
    {
      "name": "top",
      "type": "number",
      "default": "24",
      "description": "Distance from the top of the scroll area where cards pin (px)."
    },
    {
      "name": "peek",
      "type": "number",
      "default": "16",
      "description": "Offset between stacked cards (px)."
    },
    {
      "name": "scaleStep",
      "type": "number",
      "default": "0.05",
      "description": "Shrink per buried card."
    },
    {
      "name": "autoScroll",
      "type": "number",
      "default": "-",
      "description": "Scroll the page on its own (px/s) until the user interacts."
    }
  ],
  "createdAt": "2026-10-18",
  "assets": [
    {
      "file": "intense-eye.webp",
      "author": "westkast",
      "source": "https://www.lummi.ai/photo/intense-eye-close-up-gbx9c",
      "license": "Lummi License (free, credit appreciated)"
    },
    {
      "file": "textured-glass.webp",
      "author": "nikadominguez_",
      "source": "https://www.lummi.ai/photo/textured-glass-surface-se_y_",
      "license": "Lummi License (free, credit appreciated)"
    },
    {
      "file": "contrasting-vision.webp",
      "author": "berol-oac",
      "source": "https://www.lummi.ai/photo/contrasting-vision-ku-jk",
      "license": "Lummi License (free, credit appreciated)"
    },
    {
      "file": "metallic-droplets.webp",
      "author": "nikadominguez_",
      "source": "https://www.lummi.ai/photo/floating-metallic-droplets-cdwx",
      "license": "Lummi License (free, credit appreciated)"
    },
    {
      "file": "close-up-eye.webp",
      "author": "rena",
      "source": "https://www.lummi.ai/photo/close-up-eye-portrait-axhc4",
      "license": "Lummi License (free, credit appreciated)"
    }
  ],
  "controls": [
    {
      "prop": "top",
      "type": "number",
      "min": 0,
      "max": 120,
      "step": 4,
      "default": 24
    },
    {
      "prop": "peek",
      "type": "number",
      "min": 0,
      "max": 48,
      "step": 2,
      "default": 16
    },
    {
      "prop": "scaleStep",
      "type": "number",
      "min": 0,
      "max": 0.12,
      "step": 0.01,
      "default": 0.05
    },
    {
      "prop": "autoScroll",
      "type": "number",
      "min": 0,
      "max": 400,
      "step": 10,
      "default": 160
    }
  ]
}
