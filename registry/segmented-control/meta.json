{
  "slug": "segmented-control",
  "name": "Segmented Control",
  "description": "An Apple-style segmented control: the selected pill slides to your pick on a spring and the labels settle under it; arrow keys, roving focus, icons (optionally with only the selected label shown), controlled or not, and a haptic tick on change.",
  "category": "navigation",
  "collection": "craft",
  "tags": [
    "segmented",
    "tabs",
    "toggle",
    "layout",
    "keyboard",
    "spring"
  ],
  "author": {
    "name": "Copia",
    "github": "MAUXII"
  },
  "inspiration": {
    "author": "original",
    "url": null
  },
  "credits": [
    {
      "author": "Apple (Human Interface Guidelines: Segmented controls)",
      "url": "https://developer.apple.com/design/human-interface-guidelines/segmented-controls",
      "handle": "apple"
    }
  ],
  "dependencies": [
    "motion",
    "lucide-react"
  ],
  "props": [
    {
      "name": "options",
      "type": "{ value, label, icon? }[]",
      "default": "-",
      "description": "Segments in order."
    },
    {
      "name": "value / defaultValue / onValueChange",
      "type": "string / string / (v) => void",
      "default": "first option",
      "description": "Controlled or uncontrolled."
    },
    {
      "name": "size",
      "type": "\"sm\" | \"md\"",
      "default": "\"md\"",
      "description": "Height and text size."
    },
    {
      "name": "label",
      "type": "string",
      "default": "\"Options\"",
      "description": "Accessible name of the group."
    },
    {
      "name": "haptics",
      "type": "boolean",
      "default": "true",
      "description": "Vibrate briefly on change, where supported."
    },
    {
      "name": "labels",
      "type": "\"always\" | \"active\"",
      "default": "\"always\"",
      "description": "\"active\" shows icons only and opens the selected option's label, its width animating with the pill."
    }
  ],
  "controls": [
    {
      "prop": "size",
      "type": "select",
      "options": [
        "md",
        "sm"
      ],
      "default": "md"
    },
    {
      "prop": "labels",
      "type": "select",
      "options": [
        "always",
        "active"
      ],
      "default": "always"
    }
  ],
  "createdAt": "2026-10-23"
}
