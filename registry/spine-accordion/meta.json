  "props": [
    {
      "name": "items",
      "type": "{ title, image, meta? }[]",
      "default": "-",
      "description": "Pieces in shelf order."
    },
    {
      "name": "index / defaultIndex / onIndexChange",
      "type": "number / number / (i) => void",
      "default": "- / 0 / -",
      "description": "Controlled or uncontrolled open panel."
    },
    {
      "name": "spine",
      "type": "string (CSS length)",
      "default": "\"4rem\"",
      "description": "Thickness of a closed spine; also the open picture's inset."
    },
    {
      "name": "numbered",
      "type": "boolean",
      "default": "false",
      "description": "Number the spines (01, 02…)."
    },
    {
      "name": "autoplay",
      "type": "number",
      "default": "0",
      "description": "Open the next piece every N ms; hover, focus and touch pause it."
    }
  ],
