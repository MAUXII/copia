  "dependencies": [
    "motion",
    "lucide-react"
  ],
  "props": [
    {
      "name": "images",
      "type": "{ src, alt }[]",
      "default": "-",
      "description": "Slides in order."
    },
    {
      "name": "size",
      "type": "number",
      "default": "300",
      "description": "Slide width and height in px."
    },
    {
      "name": "spaceBetween",
      "type": "number",
      "default": "0",
      "description": "Space between slides in px."
    },
    {
      "name": "rotate",
      "type": "number",
      "default": "40",
      "description": "Degrees each slide turns per slide from the centre; negative turns the other way."
    },
    {
      "name": "depth",
      "type": "number",
      "default": "100",
      "description": "How far back each slide sits per slide from the centre, in px."
    },
    {
      "name": "modifier",
      "type": "number",
      "default": "1",
      "description": "Multiplies rotate and depth."
    },
    {
      "name": "slideShadows",
      "type": "boolean",
      "default": "true",
      "description": "Shade the far edge of each side slide."
    },
    {
      "name": "loop",
      "type": "boolean",
      "default": "true",
      "description": "Wrap around at the ends."
    },
    {
      "name": "autoplay",
      "type": "number",
      "default": "0",
      "description": "Advance every N ms; hover, focus and touch pause it."
    },
    {
      "name": "showPagination / showNavigation",
      "type": "boolean",
      "default": "true / false",
      "description": "Dots under the slides / arrow buttons."
    },
    {
      "name": "reflection",
      "type": "boolean",
      "default": "false",
      "description": "A soft mirror of the slides on the floor."
    },
    {
      "name": "onActiveChange",
      "type": "(index) => void",
      "default": "-",
      "description": "Called when the centred slide changes."
    }
  ],
  "controls": [
    {
      "prop": "rotate",
      "type": "number",
      "min": -80,
      "max": 80,
      "step": 5,
      "default": 40
    },
    {
      "prop": "depth",
      "type": "number",
      "min": 0,
      "max": 400,
      "step": 10,
      "default": 100
    },
    {
      "prop": "spaceBetween",
      "type": "number",
      "min": -120,
      "max": 60,
      "step": 4,
      "default": 0
    },
    {
      "prop": "autoplay",
      "type": "number",
      "min": 0,
      "max": 4000,
      "step": 100,
      "default": 1800
    },
    {
      "prop": "slideShadows",
      "type": "boolean",
      "default": true
    },
    {
      "prop": "reflection",
      "type": "boolean",
      "default": false
    }
  ],
  "createdAt": "2026-10-23"
}
