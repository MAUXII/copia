{
  "slug": "inverted-perspective-carousel",
  "name": "Inverted Perspective Carousel",
  "description": "Coverflow carousel: side slides turn 40° on their vertical axis and fall back in depth with their far edge in shadow; drag or flick it, it loops and snaps. Copia rebuilds Swiper's coverflow with Motion (no Swiper) and adds horizontal wheel and trackpad scrolling, click-to-centre, keyboard arrows, autoplay that pauses on hover or focus, and an optional floor reflection.",
  "category": "cards",
  "tags": [
    "carousel",
    "coverflow",
    "3d",
    "perspective",
    "drag",
    "keyboard",
    "spring"
  ],
  "author": {
