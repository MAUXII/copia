    "motion"
  ],
  "props": [
    {
      "name": "links",
      "type": "{ label, href, meta? }[]",
      "default": "-",
      "description": "Big links; meta renders as a superscript."
    },
    {
      "name": "logo",
      "type": "ReactNode",
      "default": "COPIA",
      "description": "Brand on the left of the bar."
    },
    {
      "name": "footer",
      "type": "{ label, href }[]",
      "default": "[]",
      "description": "Small links under the panel."
    },
    {
