      "type": "boolean / (open) => void",
      "default": "uncontrolled",
      "description": "Control the open state."
    },
    {
      "name": "accent",
      "type": "string",
      "default": "\"#ff2a1f\"",
      "description": "Color of the big links."
    }
  ],
  "createdAt": "2026-10-18"
