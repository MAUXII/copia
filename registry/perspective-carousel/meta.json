{
  "slug": "perspective-carousel",
  "name": "Perspective Carousel",
  "description": "Cover-flow carousel where the center card is flat and large while neighbours shrink and turn away; wraps around, drag, arrow keys, dots and autoplay.",
  "category": "cards",
  "tags": [
    "carousel",
    "cover flow",
    "3d",
    "albums",
    "drag"
  ],
  "author": {
    "name": "Copia",
    "github": "MAUXII"
  },
  "inspiration": {
    "author": "Skiper UI",
    "url": "https://skiper-ui.com/v1/skiper47"
  },
  "dependencies": [
    "motion"
  ],
  "props": [
    {
      "name": "items",
      "type": "ReactNode[]",
      "default": "-",
      "description": "Cards (covers, images, anything)."
    },
    {
      "name": "size",
      "type": "number",
      "default": "220",
      "description": "Card size in pixels."
    },
    {
      "name": "spacing",
      "type": "number",
      "default": "0.78",
      "description": "Distance between card centers as a fraction of size."
    },
    {
      "name": "autoplay",
      "type": "number",
      "default": "-",
      "description": "Advance every N ms; pauses on hover."
    },
    {
      "name": "pauseOnHover",
      "type": "boolean",
      "default": "true",
      "description": "Pause autoplay while hovered."
    },
    {
      "name": "label",
      "type": "string",
      "default": "\"Carousel\"",
      "description": "Accessible name."
    }
  ],
  "createdAt": "2026-10-18",
  "assets": [
    {
      "file": "crimson-contemplation.webp",
      "author": "pablostanley",
      "source": "https://www.lummi.ai/photo/crimson-contemplation-5sozs",
      "license": "Lummi License (free, credit appreciated)"
    },
    {
      "file": "artistic-orchid.webp",
      "author": "ms.designs.0711",
      "source": "https://www.lummi.ai/photo/artistic-orchid-close-up-pv618",
      "license": "Lummi License (free, credit appreciated)"
    },
    {
      "file": "elegant-red-portrait.webp",
      "author": "axelnascimentto",
      "source": "https://www.lummi.ai/photo/elegant-red-portrait-lx5ig",
      "license": "Lummi License (free, credit appreciated)"
    },
    {
      "file": "white-flowers-on-black.webp",
      "author": "clemara_studio",
      "source": "https://www.lummi.ai/photo/white-flowers-on-black-1byya",
      "license": "Lummi License (free, credit appreciated)"
    },
    {
      "file": "red-light-portrait.webp",
      "author": "harshworks",
      "source": "https://www.lummi.ai/photo/red-light-portrait-lstku",
      "license": "Lummi License (free, credit appreciated)"
    },
    {
      "file": "fiery-profile.webp",
      "author": "ibis_design",
      "source": "https://www.lummi.ai/photo/fiery-profile-portrait-fatsu",
      "license": "Lummi License (free, credit appreciated)"
    }
  ],
  "controls": [
    {
      "prop": "size",
      "type": "number",
      "min": 120,
      "max": 320,
      "step": 10,
      "default": 200
    },
    {
      "prop": "spacing",
      "type": "number",
      "min": 0.4,
      "max": 1.2,
      "step": 0.02,
      "default": 0.78
    },
    {
      "prop": "autoplay",
      "type": "number",
      "min": 0,
      "max": 4000,
      "step": 100,
      "default": 1200
    }
  ]
}
