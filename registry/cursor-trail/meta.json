{
  "slug": "cursor-trail",
  "name": "Cursor Trail",
  "description": "Drops images or stickers along the cursor path that pop in with a spring and shrink away; any ReactNode, spacing, lifetime and cap configurable.",
  "category": "effects",
  "tags": [
    "cursor",
    "trail",
    "stickers",
    "images",
    "awwwards"
  ],
  "author": {
    "name": "Copia",
    "github": "MAUXII"
  },
  "inspiration": {
    "author": "BeFreaky (David Denni)",
    "url": "https://www.befreaky.co/"
  },
  "dependencies": [
    "motion",
    "lucide-react"
  ],
  "props": [
    {
      "name": "items",
      "type": "ReactNode[]",
      "default": "-",
      "description": "What is dropped: images, stickers, emoji."
    },
    {
      "name": "spacing",
      "type": "number",
      "default": "60",
      "description": "Pixels between two drops."
    },
    {
      "name": "lifetime",
      "type": "number",
      "default": "900",
      "description": "Milliseconds before a drop shrinks away."
    },
    {
      "name": "max",
      "type": "number",
      "default": "14",
      "description": "Maximum drops on screen."
    },
    {
      "name": "size",
      "type": "number",
      "default": "96",
      "description": "Drop size in pixels."
    }
  ],
  "createdAt": "2026-10-18"
}
