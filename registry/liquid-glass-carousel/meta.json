  "dependencies": [
    "three",
    "gsap"
  ],
  "props": [
    {
      "name": "items",
      "type": "{ src, title, aspect? }[]",
      "default": "8 Unsplash photos",
      "description": "Photos in order. Aspect is read from the image when omitted."
    },
    {
      "name": "panelHeight",
      "type": "number",
      "default": "450",
      "description": "Target panel height in px; capped at 52% of the container."
    },
    {
      "name": "gap",
      "type": "number",
      "default": "12",
      "description": "Space between panels."
    },
    {
      "name": "background",
      "type": "string",
      "default": "\"#ffffff\"",
      "description": "Page colour behind the row (hex). Copia masks the glow to the images, so dark pages work too."
    },
    {
      "name": "entry",
      "type": "boolean",
      "default": "true",
      "description": "Rise-and-grow intro."
    },
    {
      "name": "lens",
      "type": "Partial<LiquidGlassLens>",
      "default": "-",
      "description": "Copia: override any lens setting: sizeX, sizeY, rotation, dispersion, blueRing, rimTangential, shimmer, glow…"
    },
    {
      "name": "lensColor",
      "type": "string",
      "default": "\"#009dff\"",
      "description": "Copia: colour of the glowing ring."
    },
    {
      "name": "autoplay",
      "type": "number",
      "default": "0",
      "description": "Copia: seconds between automatic steps; input pauses it for 4 s."
    },
    {
      "name": "foreground",
      "type": "string",
      "default": "\"#111111\"",
      "description": "Copia: title and counter colour, for dark backgrounds."
    },
    {
      "name": "onActiveChange / onFocusChange",
      "type": "(index) => void / (focused) => void",
      "default": "-",
      "description": "Called when the centred photo or the focus changes."
    }
  ],
  "controls": [
    {
      "prop": "dispersion",
      "type": "number",
      "min": 0,
      "max": 30,
      "step": 1,
      "default": 11
    },
    {
      "prop": "ring",
      "type": "number",
      "min": 0,
      "max": 12,
      "step": 0.5,
      "default": 6
    },
    {
      "prop": "rotation",
      "type": "number",
      "min": 0,
      "max": 180,
      "step": 5,
      "default": 65
    },
    {
      "prop": "gap",
      "type": "number",
      "min": 0,
      "max": 48,
      "step": 2,
      "default": 12
    },
    {
      "prop": "autoplay",
      "type": "number",
      "min": 0,
      "max": 5,
      "step": 0.1,
      "default": 1.8
    },
    {
      "prop": "lensColor",
      "type": "color",
      "default": "#009dff"
    }
  ],
  "createdAt": "2026-10-22"
}
