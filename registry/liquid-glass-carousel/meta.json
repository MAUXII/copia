  "dependencies": [],
  "props": [
    {
      "name": "items",
      "type": "{ src, title, aspect? }[]",
      "default": "-",
      "description": "Photos in order. Aspect is read from the image when omitted."
    },
    {
      "name": "panelHeight",
      "type": "number",
      "default": "450",
      "description": "Target panel height in px; capped at 52% of the container."
    },
    {
      "name": "gap",
      "type": "number",
      "default": "12",
      "description": "Space between panels."
    },
    {
      "name": "radius",
      "type": "number",
      "default": "6",
      "description": "Panel corner radius in px."
    },
    {
      "name": "lensSize",
      "type": "number",
      "default": "1",
      "description": "Lens size as a multiple of the reference lens."
    },
    {
      "name": "lensColor",
      "type": "string",
      "default": "\"#ff7a45\"",
      "description": "Colour of the glowing ring at the lens rim."
    },
    {
      "name": "dispersion",
      "type": "number",
      "default": "11",
      "description": "Chromatic split at the rim; 0 turns it off."
    },
    {
      "name": "autoplay",
      "type": "number",
      "default": "0",
      "description": "Seconds between automatic steps; input pauses it for 4 s."
    },
    {
      "name": "entry",
      "type": "boolean",
      "default": "true",
      "description": "Panels rise in and the lens blooms on mount."
    },
    {
      "name": "onActiveChange",
      "type": "(index) => void",
      "default": "-",
      "description": "Called when the centred photo changes."
    }
  ],
  "controls": [
    {
      "prop": "lensSize",
      "type": "number",
      "min": 0.5,
      "max": 1.5,
      "step": 0.05,
      "default": 1
    },
    {
      "prop": "dispersion",
      "type": "number",
      "min": 0,
      "max": 30,
      "step": 1,
      "default": 11
    },
    {
      "prop": "radius",
      "type": "number",
      "min": 0,
      "max": 32,
      "step": 1,
      "default": 6
    },
    {
      "prop": "gap",
      "type": "number",
      "min": 0,
      "max": 48,
      "step": 2,
      "default": 12
    },
    {
      "prop": "autoplay",
      "type": "number",
      "min": 0,
      "max": 5,
      "step": 0.1,
      "default": 1.8
    }
  ],
  "createdAt": "2026-10-22"
}
