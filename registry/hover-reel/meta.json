  "props": [
    {
      "name": "projects",
      "type": "{ title, label, image, href? }[]",
      "default": "-",
      "description": "Rows in order; image is the picture shown on hover."
    },
    {
      "name": "width",
      "type": "number",
      "default": "320",
      "description": "Frame width in px; height follows at 16:10."
    },
    {
      "name": "cursorLabel",
      "type": "string",
      "default": "\"View\"",
      "description": "Text on the round badge riding the frame; empty hides it."
    },
    {
      "name": "tilt",
      "type": "number",
      "default": "6",
      "description": "Max degrees the frame leans into fast horizontal moves; 0 keeps it upright."
    }
  ],
  "controls": [
